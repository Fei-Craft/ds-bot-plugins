{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DS Bot Plugin Manifest v1",
  "type": "object",
  "required": ["id", "name", "description", "category", "kind", "install"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(dsh|mcp):[a-z0-9][a-z0-9._/@-]{1,100}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1, "maxLength": 600 },
    "author": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "maxLength": 40 },
    "category": {
      "type": "string",
      "enum": ["browser", "tools", "productivity", "dev", "data", "other"]
    },
    "slot": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "kind": { "type": "string", "enum": ["dsh", "mcp"] },
    "featured": { "type": "boolean" },
    "verified": { "type": "boolean" },
    "tags": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 32 }
    },
    "toolPrefixes": {
      "type": "array",
      "maxItems": 24,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "homepage": { "type": "string", "format": "uri" },
    "repository": { "type": "string", "format": "uri" },
    "locales": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "minLength": 1, "maxLength": 600 }
        }
      }
    },
    "install": {
      "type": "object",
      "properties": {
        "packageName": { "type": "string", "minLength": 1 },
        "spec": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "mcp": {
          "type": "object",
          "required": ["transport"],
          "properties": {
            "transport": { "type": "string", "enum": ["stdio", "streamable-http"] },
            "packageSpec": { "type": "string" },
            "command": { "type": "string" },
            "args": { "type": "array", "items": { "type": "string" } },
            "env": { "type": "object", "additionalProperties": { "type": "string" } },
            "url": { "type": "string" },
            "headers": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        }
      }
    }
  }
}
